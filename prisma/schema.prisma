generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Frictionless capture
  upiId            String?   // for "Pay via UPI" settle links
  apiTokenHash     String?   @unique // personal token for Siri/Shortcuts (sha256)
  defaultGroupId   String?   // where "milk 20" goes; null = personal
  linkCode         String?   @unique // one-time Telegram link code
  linkCodeExpires  DateTime?

  // Friends who haven't signed up yet: a placeholder user owned by whoever added them.
  // They claim it (set username + password) via /claim/[claimCode].
  isPlaceholder    Boolean   @default(false)
  claimCode        String?   @unique
  addedById        String?

  // Relations
  groupMemberships GroupMember[]
  expensesPaid     Expense[]       @relation("PaidBy")
  expensesCreated  Expense[]       @relation("CreatedBy")
  expenseSplits    ExpenseSplit[]
  settlementsFrom  Settlement[]    @relation("SettlementFrom")
  settlementsTo    Settlement[]    @relation("SettlementTo")
  activities       Activity[]
  telegramLink     TelegramLink?
  payeeRules       PayeeRule[]
  paymentMethods   PaymentMethod[]
  aiCalls          AiCall[]
}

// How you paid: "PhonePe", "HDFC credit card", "Cash"…  Per user, reorderable.
model PaymentMethod {
  id         String    @id @default(cuid())
  userId     String
  name       String
  kind       String    @default("upi") // upi | card | cash | bank | other
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId])
}

// One row per natural-language parse, for rate limiting and debugging bad parses.
model AiCall {
  id        String   @id @default(cuid())
  userId    String
  input     String
  output    String?
  model     String
  ms        Int
  ok        Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TelegramLink {
  id               String   @id @default(cuid())
  telegramId       String   @unique
  telegramUsername String?
  userId           String   @unique
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  inviteCode  String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime? // Soft delete
  isPersonal  Boolean   @default(false) // hidden single-member ledger for personal expenses
  isDirect    Boolean   @default(false) // hidden two-member ledger for 1:1 friend expenses

  // Relations
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  activities  Activity[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Expense {
  id          String    @id @default(cuid())
  groupId     String
  description String
  amount      Int       // Store in smallest unit (paise)
  currency    String    @default("INR")
  category    String    @default("other")
  date        DateTime
  paidById    String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete

  // Capture metadata
  source      String    @default("web") // web | telegram | shortcut | sms
  needsReview Boolean   @default(false) // auto-captured, not yet confirmed
  payee       String?   // merchant / VPA from bank SMS
  externalRef String?   // UPI ref no. for de-dupe
  reviewMsgId String?   // Telegram message id of the review prompt

  // Personal-finance fields (from the payer's point of view)
  needLevel       String?  // essential | semi | luxury
  paymentMethodId String?
  notes           String?
  splitType       String   @default("equal") // equal | exact | percent | shares

  // Relations
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("PaidBy", fields: [paidById], references: [id])
  createdBy User           @relation("CreatedBy", fields: [createdById], references: [id])
  splits    ExpenseSplit[]
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([externalRef])
  @@index([groupId, date])
}

// Remembers what a payee usually is ("SWIGGY" -> Food / "Swiggy")
model PayeeRule {
  id          String   @id @default(cuid())
  userId      String
  payeeKey    String
  description String
  category    String
  groupId     String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, payeeKey])
}

model ExpenseSplit {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  amount    Int    // What this user owes (in paise)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model Settlement {
  id         String   @id @default(cuid())
  groupId    String
  fromUserId String   // Who paid
  toUserId   String   // Who received
  amount     Int      // In paise
  note       String?
  date       DateTime
  createdAt  DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  groupId   String
  userId    String   // Who performed the action
  type      String   // expense_added, expense_edited, expense_deleted, settlement, member_joined, member_left
  metadata  String?  // JSON string for additional data
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}
